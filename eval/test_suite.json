  "memory_tests": [
    {
      "test_id": "mem_001",
      "description": "STM: write 3 turns, read back, check history preserved",
      "session_id": "mem_test_session",
      "turns": [
        {
          "role": "user",
          "content": "What is BM25?"
        },
        {
          "role": "assistant",
          "content": "BM25 is a ranking function."
        },
        {
          "role": "user",
          "content": "How is it different from dense retrieval?"
        }
      ]
    },
    {
      "test_id": "mem_002",
      "description": "LTM: store Q&A, search by keyword, expect recall",
      "session_id": "ltm_test_session",
      "qa_pairs": [
        {
          "question": "What is reciprocal rank fusion?",
          "answer": "RRF merges ranked lists using rank positions without score normalisation.",
          "source_ids": [
            "chunk_retrieval_01"
          ]
        }
      ],
      "search_query": "rank fusion merging lists",
      "expect_hit": true
    }
  ],
  "cache_tests": [
    {
      "test_id": "cache_001",
      "description": "Cold miss: first encode of a text should be a cache miss",
      "text": "This is a unique test sentence for cache validation 12345",
      "expect_hit": false
    },
    {
      "test_id": "cache_002",
      "description": "Warm hit: re-encoding same text should be a cache hit and faster",
      "text": "This is a unique test sentence for cache validation 12345",
      "expect_hit": true,
      "expect_speedup": true
    }
  ],
  "self_check_tests": [
    {
      "test_id": "sc_001",
      "description": "Grounded answer \u2014 high token overlap with context",
      "context": "BM25 is a sparse retrieval method based on term frequency and inverse document frequency. It scores documents by how often query terms appear relative to their frequency across all documents.",
      "answer": "BM25 uses term frequency and inverse document frequency to score documents.",
      "expect_grounded": true,
      "expect_verdict": "pass"
    },
    {
      "test_id": "sc_002",
      "description": "Ungrounded answer \u2014 quantum topic injected, context is about retrieval",
      "context": "BM25 is a sparse retrieval method based on term frequency and inverse document frequency.",
      "answer": "Quantum entanglement allows particles to instantaneously affect each other across vast distances, which was described by Einstein as spooky action at a distance.",
      "expect_grounded": false,
      "expect_verdict": "fail"
    },
    {
      "test_id": "sc_003",
      "description": "Partial grounding \u2014 some claims supported, some not",
      "context": "Dense retrieval encodes text as vectors for approximate nearest neighbour search.",
      "answer": "Dense retrieval uses vectors. It was invented in 2021 by researchers at Google.",
      "expect_grounded": true,
      "expect_verdict": "warn"
    }
  ]
}